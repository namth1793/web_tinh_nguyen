# Copy this file to .env and fill in the values

PORT=5030
NODE_ENV=production

# Generate a strong random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret

# Netlify frontend URL (no trailing slash)
# e.g. https://phatphap.netlify.app
CORS_ORIGIN=https://your-site.netlify.app

# Railway Volume mount path for SQLite
# In Railway dashboard: Add Volume → Mount Path: /data
DB_PATH=/data/phatphap.db
